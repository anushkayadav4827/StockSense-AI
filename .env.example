# StockSense AI — Environment Configuration Template
# Copy this file to .env and insert your real API credentials

# Groq Cloud API Key for AI Market Analyst (Free tier available at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Twelve Data API Key for real-time market quotes (Free tier available at https://twelvedata.com)
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# MarketStack API Key (Optional tertiary feed: https://marketstack.com)
MARKETSTACK_API_KEY=your_marketstack_api_key_here
